# cp .env.example .env, then fill in real values. Never commit .env.
# Read by mcp/telegram-mcp/telegram_mcp.py as environment variables.

TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Read by ~/mcp/webull-mcp/webull_mcp.py -- the live_direct execution server.
# From Webull's OpenAPI Management console. WEBULL_ENV defaults to "sandbox"
# if unset; set it to "production" only when you mean it.
WEBULL_APP_KEY=YOUR_WEBULL_APP_KEY
WEBULL_APP_SECRET=YOUR_WEBULL_APP_SECRET
WEBULL_ACCOUNT_ID=YOUR_WEBULL_ACCOUNT_ID
WEBULL_ENV=sandbox
