[Unit]
Description=buffet bot — stop watcher (trails and enforces stops, sells only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/buffet-bot
# Webull credentials and the Telegram token. trail.py only acts when
# config.json execution_mode is live_direct; otherwise it prints a dry run.
EnvironmentFile=%h/buffet-bot/.env
ExecStart=%h/mcp/webull-mcp/venv/bin/python3 %h/buffet-bot/lib/trail.py
TimeoutStartSec=240
